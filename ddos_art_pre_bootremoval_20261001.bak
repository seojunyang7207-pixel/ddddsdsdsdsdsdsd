# ---------------------------------------------------------------------------
# Main screen 'art rain' settings
# ---------------------------------------------------------------------------
# Intro timing for the 'pour down once then stop' effect
RAIN_DROP_SEC = 0.45          # First entry: drop time for the logo falling from the top (seconds)
