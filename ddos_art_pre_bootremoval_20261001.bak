# -*- coding: utf-8 -*-
"""
RAIN Console Art Engine
==========================
- Automatic Windows / Linux terminal color activation (ANSI / VT)
- Main screen art banner + rain effect where the logo art pours down on entry (not digits/letters)
- 'Paragraph-by-paragraph' effect when an attack starts (typewriter + paragraph cascade output)
- Real-time status bar updated every second during an attack
- Interactive main menu (attack wizard / tools console / direct command execution)

This module is imported and used by start.py.
When run standalone (python ddos_art.py) it acts as an effect preview demo.
"""
import os
import sys
import time
import shutil
import ctypes
import subprocess


# ---------------------------------------------------------------------------
# ANSI color constants
# ---------------------------------------------------------------------------
class C:
    R = "\x1b[91m"     # bright red
    G = "\x1b[92m"     # bright green
    Y = "\x1b[93m"     # bright yellow
    B = "\x1b[94m"     # bright blue
    M = "\x1b[95m"     # bright magenta
    CY = "\x1b[96m"    # bright cyan
    W = "\x1b[97m"     # bright white
    DIM = "\x1b[2m"
    BOLD = "\x1b[1m"
    UND = "\x1b[4m"
    REV = "\x1b[7m"
    RST = "\x1b[0m"


# Rainbow-family color cycle used for banners
RAINBOW = [C.M, C.CY, C.W, C.CY, C.G, C.Y, C.R, C.M]


