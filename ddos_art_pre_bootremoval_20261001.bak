RAIN_REPEAT_SEC = 1.1
RAIN_CHARS = "01ABCDEF#$%&@*+=^~[]{}|;:.,-_<>/\\"
_RAIN_PLAYED = False     # Whether this is the first entry (for the main screen effect)

# ---------------------------------------------------------------------------
# Console initialization
# ---------------------------------------------------------------------------
_COLOR = True          # Whether color is used
_INIT_DONE = False     # Whether initialization has run once


# ---------------------------------------------------------------------------
# Light blue -> sky blue gradient engine
#   Paints all console output text with a "left-to-right
#   light blue -> sky blue gradient". (256-color palette)
#
# How it works
#   1) Split the text into lines, then for each line use the first/last visible character's
#      position to pick a color number from a 48-step ramp by character position.
#   2) Strip existing ANSI color codes and keep only style attributes
#      (bold/dim/underline/reverse), then re-apply a 38;5;N code per character.
#   3) Intercept print / input module-wide so they pass through this engine.
# ---------------------------------------------------------------------------
import re as _re
import builtins as _b

_GRAD_FROM = (150, 200, 255)    # light blue (left end)
_GRAD_TO = (60, 195, 255)       # sky blue (right end)
_GRAD_STEPS = 48                # number of ramp color steps

_RAMP_CACHE = None              # lazy-computed color ramp cache


def _near256(r, g, b):
    """Return the xterm-256 color number (16-255) closest to (r,g,b)."""
    best = 16
    bd = None
    for ri in range(6):          # 6x6x6 cube (0,95,135,175,215,255)
        rv = 0 if ri == 0 else 55 + 40 * ri
        for gi in range(6):
            gv = 0 if gi == 0 else 55 + 40 * gi
            for bi in range(6):
                bv = 0 if bi == 0 else 55 + 40 * bi
                d = (rv - r) ** 2 + (gv - g) ** 2 + (bv - b) ** 2
                if bd is None or d < bd:
                    bd, best = d, 16 + 36 * ri + 6 * gi + bi
    for k in range(24):          # include the gray ramp 232-255 as candidates too
        v = 8 + 10 * k
        d = (v - r) ** 2 + (v - g) ** 2 + (v - b) ** 2
        if d < bd:
            bd, best = d, 232 + k
    return best


def _grad_ramp():
    """Array of xterm-256 codes for the light blue->sky blue _GRAD_STEPS ramp (lazy + cached)."""
    global _RAMP_CACHE
    if _RAMP_CACHE is None:
        n = max(1, _GRAD_STEPS - 1)
        ramp = []
        for i in range(_GRAD_STEPS):
            t = i / float(n)
            r = int(round(_GRAD_FROM[0] + (_GRAD_TO[0] - _GRAD_FROM[0]) * t))
            g = int(round(_GRAD_FROM[1] + (_GRAD_TO[1] - _GRAD_FROM[1]) * t))
            b = int(round(_GRAD_FROM[2] + (_GRAD_TO[2] - _GRAD_FROM[2]) * t))
            ramp.append(_near256(r, g, b))
        _RAMP_CACHE = ramp
    return _RAMP_CACHE


def _sgr_state(params, st):
    """Parse SGR parameters (list of ints) and update the style state dict.

    All color-related codes (30-37/40-47/90-97/100-107/38/48) are discarded
    and only bold(1)/dim(2)/underline(4)/reverse(7) styles are kept.
    """
    i, n = 0, len(params)
    while i < n:
        p = params[i]
        if p == 0:
            st.update(bold=False, dim=False, under=False, rev=False)
        elif p == 1:
            st["bold"] = True
        elif p == 2:
            st["dim"] = True
        elif p == 22:
            st["bold"] = False
            st["dim"] = False
        elif p in (4, 21):
            st["under"] = True
        elif p == 24:
            st["under"] = False
        elif p == 7:
            st["rev"] = True
        elif p == 27:
            st["rev"] = False
        elif p in (38, 48):          # extended color -- skip the following mode/value parameters too
            if i + 1 < n and params[i + 1] == 5:
                i += 2
            elif i + 1 < n and params[i + 1] == 2:
                i += 4
        i += 1
    return st


def _attr_sgr(st, code):
    """Build an SGR string containing style attributes + a gradient color code.
    Always starts with '0' (reset) so the previous color does not leak."""
    parts = ["0"]
    if st.get("bold"):
        parts.append("1")
    if st.get("dim"):
        parts.append("2")
    if st.get("under"):
        parts.append("4")
    if st.get("rev"):
        parts.append("7")
    parts.append("38;5;%d" % code)
    return "\x1b[" + ";".join(parts) + "m"


_SGR_RE = _re.compile(r"\x1b\[[0-9;]*m")


def _grad_line(line, ramp):
    """Convert a single line of text into a left->right blue->white gradient string.

    - If there is no visible character (blank line / only control sequences) the original is returned.
    - Whitespace/control characters (\r etc.) are not painted, but internal spaces count toward
      position calculation so the gradient flows naturally even across wide gaps.
    """
    if not line:
        return line

    # 1) Tokenize: (type, text) -- txt=plain char, sgr=style code, ctl=other control
    toks = []
    i, n = 0, len(line)
    while i < n:
        if line[i] == "\x1b" and i + 1 < n and line[i + 1] == "[":
            j = i + 2
            while j < n and not (0x40 <= ord(line[j]) <= 0x7E):
                j += 1
            if j >= n:                # ended without a terminator -- take the rest whole
                j = n - 1
            j += 1
            raw = line[i:j]
            toks.append(("sgr" if raw.endswith("m") else "ctl", raw))
            i = j
        else:
            j = i
            while j < n and not (line[j] == "\x1b" and j + 1 < n and line[j + 1] == "["):
                j += 1
            toks.append(("txt", line[i:j]))
            i = j

    # 2) Compute the position of the first/last visible (non-space) character
    pos = 0
    first = last = -1
    for typ, txt in toks:
        if typ != "txt":
            continue
        for ch in txt:
            if ch != " " and ord(ch) >= 32 and ch != "\x7f":
                if first < 0:
                    first = pos
                last = pos
            pos += 1

    if first < 0:                     # no visible character -> original text as-is
        return line

    span = last - first
    out = []
    pos = 0
    st = {"bold": False, "dim": False, "under": False, "rev": False}
    for typ, txt in toks:
        if typ == "sgr":
            params = [int(x) for x in txt[2:-1].split(";") if x != ""]
            if not params:
                params = [0]
            _sgr_state(params, st)
        elif typ == "ctl":
            out.append(txt)           # keep control sequences such as cursor movement as-is
        else:
            for ch in txt:
                if ch == " " or ord(ch) < 32 or ch == "\x7f":
                    # unpainted char (space/control): keep only the style attribute if any
                    if st.get("bold") or st.get("dim") or st.get("under") or st.get("rev"):
                        out.append(_attr_only_sgr(st))
                    out.append(ch)
                else:
                    if span <= 0:
                        t = 0.5
                    else:
                        t = (pos - first) / float(span)
                    idx = int(round(t * (_GRAD_STEPS - 1)))
                    out.append(_attr_sgr(st, ramp[idx]))
                    out.append(ch)
                pos += 1

    # Reset the color left on the last character so it does not affect the next output
    out.append(C.RST)
    return "".join(out)


def _attr_only_sgr(st):
    """SGR with style attributes only, no color (for styled spaces)."""
    parts = ["0"]
    if st.get("bold"):
        parts.append("1")
    if st.get("dim"):
        parts.append("2")
    if st.get("under"):
        parts.append("4")
    if st.get("rev"):
        parts.append("7")
    return "\x1b[" + ";".join(parts) + "m"


def gradientize(text):
    """Convert text into a light blue->sky blue gradient string.

    - If color is disabled (_COLOR=False) or there is no visible character, the input is returned as-is.
    - The gradient is applied per line (split on \n), so every line runs from light blue at the left
      to sky blue at the right end.
    """
    if not text or not _COLOR:
        return text
    if "\n" not in text:
        return _grad_line(text, _grad_ramp())
    ramp = _grad_ramp()
    return "\n".join(_grad_line(ln, ramp) for ln in text.split("\n"))


def _gprint(*args, sep=" ", end="\n", file=None, flush=False):
    """Replacement print that applies the gradient to all print output."""
    stream = sys.stdout if file is None else file
    text = sep.join(str(a) for a in args)
    stream.write(gradientize(text + end))
    if flush:
        stream.flush()


def _ginput(prompt=""):
    """Replacement input that applies the gradient to the prompt text too."""
    return _b.input(gradientize(prompt))


# Replace the module-wide print / input with the gradient versions
# (a print() call inside a function resolves this module global at run time,
#  so it applies equally to functions defined before this declaration.)
print = _gprint
input = _ginput


def init():
    """Enable VT (ANSI) processing on the Windows console and decide whether color is supported."""
    global _COLOR, _INIT_DONE
    if _INIT_DONE:
        return _COLOR
    _INIT_DONE = True

    if os.environ.get("NO_COLOR"):
        _COLOR = False
        return _COLOR

    if os.name == "nt":                      # Windows: cmd / powershell
        try:
            k32 = ctypes.windll.kernel32
            out = k32.GetStdHandle(-11)      # STD_OUTPUT_HANDLE
            mode = ctypes.c_uint32()
            if k32.GetConsoleMode(out, ctypes.byref(mode)):
                VT = 0x0004                  # ENABLE_VIRTUAL_TERMINAL_PROCESSING
                k32.SetConsoleMode(out, mode.value | VT)
        except Exception:
            pass

    _COLOR = bool(sys.stdout and sys.stdout.isatty())
    return _COLOR


def is_color():
    return _COLOR


def paint(text, code, bold=False):
    """Return the string wrapped in a color code. Returned as-is when color is unsupported."""
    if not _COLOR:
        return text
    return f"{C.BOLD if bold else ''}{code}{text}{C.RST}"


def clear_screen():
    if _COLOR:
        print("\x1b[2J\x1b[H", end="", flush=True)
    else:
        print("\n" * 3)


# ---------------------------------------------------------------------------
# Output effects
# ---------------------------------------------------------------------------
# Default inter-line flow delay (top->down cascade speed: 0.04s/line)
_LINE_FLOW_DELAY = 0.04


def typewrite(text, delay=None, end="\n"):
    """Print line by line flowing from top to bottom (vertical cascade).

    Previously each character was typed left->right, but now
    the whole line appears at once and lines follow quickly downward in a
    'top->down loading' fashion. All text is first painted with the
    light blue->sky blue gradient.
    """
    if not text and not end:
        return
    if delay is None:
        delay = _LINE_FLOW_DELAY
    delay = max(0.006, float(delay or 0))
    out = gradientize(text) + (end or "")
    sys.stdout.write(out)
    sys.stdout.flush()
    if delay:
        time.sleep(delay)


def cascade(lines, delay=0.04, color=None, indent="", pause=0.0):
    """Rapidly flow multiple lines from top to bottom (vertical cascade)."""
    for ln in lines:
        if color:
            ln = paint(ln, color)
        typewrite(indent + ln, delay=delay)
        if pause:
            time.sleep(pause)


def pour(paragraphs, para_gap=0.16, char_delay=0.04, indent="  "):
    """
    'Paragraph-by-paragraph vertical cascade' output.

    paragraphs : list of list[str]  (paragraph -> lines)
    Lines flow downward, and when each paragraph ends it pauses briefly
    before the next paragraph flows down. char_delay acts as the inter-line delay (seconds).
    """
    first = True
    for para in paragraphs:
        if not first:
            time.sleep(para_gap)
        first = False
        if isinstance(para, str):
            para = [para]
        for ln in para:
            typewrite(indent + ln, delay=max(0.008, char_delay))
        print("", flush=True)


def banner_rainbow(art, color_cycle=None, center=True):
    """Paint each line of the art with a cycling rainbow color (centered by default)."""
    cycle = color_cycle or RAINBOW
    lines = art.rstrip("\n").split("\n")
    if center:
        lines = _center_art_lines(lines)
    out = []
    for i, ln in enumerate(lines):
        if ln.strip():
            out.append(paint(ln, cycle[i % len(cycle)], bold=True))
        else:
            out.append("")
    return out


def term_width():
    try:
        return shutil.get_terminal_size((100, 24)).columns
    except Exception:
        return 100


def _center_art_lines(lines):
    """Strip the common leading indent from art lines and re-pad to center them."""
    nonempty = [l for l in lines if l.strip()]
    if not nonempty:
        return lines
    lead = min(len(l) - len(l.lstrip(" ")) for l in nonempty)
    trimmed = [l[lead:] if l.strip() else "" for l in lines]
    aw = max(_plain(l) for l in trimmed if l.strip())
    pre = " " * max(0, (term_width() - aw) // 2)
    return [pre + l if l.strip() else "" for l in trimmed]


def _term_wh():
    """Current terminal size (width, height). Safe defaults when it cannot be measured."""
    try:
        sz = shutil.get_terminal_size((100, 25))
        w = max(30, min(sz.columns, 220))
        h = max(10, min(sz.lines, 60))
        return w, h
    except Exception:
        return 100, 25


# ---------------------------------------------------------------------------
# Art cascade (rain) -- logo art pouring down (replaces the digits/letters cascade)
# ---------------------------------------------------------------------------
def _art_rows(art):
    """Turn the art source into a normalized list of lines with equal width."""
    lines = art.rstrip("\n").split("\n")
    rows = [ln.rstrip() for ln in lines]
    while rows and not rows[0].strip():
        rows.pop(0)
    while rows and not rows[-1].strip():
        rows.pop()
    if not rows:
        return []
    width = max(len(ln) for ln in rows)
    return [ln + " " * (width - len(ln)) for ln in rows]


def _shrink_half(row):
    """Compress 2 columns into 1 half-block (used only when the art is wider than the terminal)."""
    chars = []
    i = 0
    while i + 1 < len(row):
        a, b = row[i], row[i + 1]
        if a == " " and b == " ":
            chars.append(" ")
        elif a == "\u2588" and b == "\u2588":
            chars.append("\u2588")
        elif a == "\u2588":
            chars.append("\u258c")     # ▌ left half block
        else:
            chars.append("\u2590")     # ▐ right half block
        i += 2
    if i < len(row):
        chars.append(row[i])
    return "".join(chars)


def art_rain(seconds=2.0, fps=14, art=None, palette=None):
    """
    A cascade effect where logo art filling the whole screen pours from top to bottom.

    Instead of the old digits/letters rain, RAIN_ART (█ block logo)
    flows down as an endlessly connected vertical curtain. Colors cycle per line, and
    if the screen is narrower than the art it auto-compresses to half blocks (▌▐) to prevent wrapping.

    Does nothing unless color/a real terminal, and if the terminal cannot render block
    characters (█ etc.) it falls back to the old digit rain (matrix_rain).
    """
    if not (_COLOR and sys.stdout and sys.stdout.isatty()):
        return
    if seconds <= 0:
        return
    if art is None:
        art = RAIN_ART
    if not art or not art.strip():
        return

    # fall back to the old digit rain if block characters (█▌▐) are unavailable
    if not _wide_ok():
        return matrix_rain(seconds, fps=min(int(fps), 30))

    rows = _art_rows(art)
    if not rows:
        return
    n_rows = len(rows)

    W, H = _term_wh()
    H = max(6, H - 1)              # reserve the bottom line

    aw = len(rows[0])
    if aw >= W:                    # compress to half blocks if the art is wider than the screen
        rows = [_shrink_half(r) for r in rows]
        aw = len(rows[0])
    if aw > W:
        rows = [r[:W] for r in rows]   # still too wide: truncate (prevents wrapping)
        aw = W
    lead = " " * ((W - aw) // 2) if aw < W else ""   # center on screen

    palette = palette or RAINBOW
    # Blue->white gradient: apply the left->right ramp independently per line.
    # The old rainbow cycled line colors, but now every line uses the same blue->white theme.
    # The source art has no SGR, so prepend bold (ESC[1m) to preserve weight.
    colored = [gradientize("\x1b[1m" + r) for r in rows]

    hide = "\x1b[?25l"
    show = "\x1b[?25h"
    erase = "\x1b[K"
    step = 1.0 / max(1.0, float(fps))
    next_tick = time.time()
    deadline = next_tick + seconds
    top = 0

    sys.stdout.write(hide)
    try:
        while True:
            if time.time() >= deadline:
                break
            # push the art tape down one line at a time and redraw the whole screen
            lines_out = []
            for y in range(H):
                r = (top + y) % n_rows
                lines_out.append(lead + colored[r] + erase)
            sys.stdout.write("\x1b[H" + "\n".join(lines_out))
            sys.stdout.flush()
            top = (top + 1) % n_rows
            next_tick += step
            delay = next_tick - time.time()
            if delay > 0:
                time.sleep(delay)
    except KeyboardInterrupt:
        pass                     # allow skipping the intro with Ctrl+C
    finally:
        sys.stdout.write("\x1b[2J\x1b[H" + show)
        sys.stdout.flush()


def art_drop(drop_sec=0.45, hold_sec=1.0, fps=None, art=None, palette=None):
    """
    Drop intro effect where the logo art (RAIN_ART) pours down once from
    above the screen (out of view) and stops in place.

    - Unlike the old cascade (art_rain) it does not keep flowing. After landing it
      stops completely, holds for hold_sec seconds, then clears the screen.
    - Rainbow colors cycle per line, and if the screen is narrower than the art it
      auto-compresses to half blocks (▌▐) to prevent wrapping.
    - Does nothing unless color/a real terminal, and if the terminal cannot render
      characters (█ etc.) it falls back to the old digit rain (matrix_rain).
    - Skipping with Ctrl+C clears the screen immediately.
    """
    if not (_COLOR and sys.stdout and sys.stdout.isatty()):
        return
    if drop_sec < 0 or hold_sec < 0:
        return
    if art is None:
        art = RAIN_ART
    if not art or not art.strip():
        return

    # fall back to the old digit rain if block characters (█▌▐) are unavailable
    if not _wide_ok():
        return matrix_rain(drop_sec + hold_sec, fps=min(int(fps or RAIN_DROP_FPS), 30))

    rows = _art_rows(art)
    if not rows:
        return
    n_rows = len(rows)

    W, H = _term_wh()
    H = max(6, H - 1)              # reserve the bottom line

    aw = len(rows[0])
    if aw >= W:                    # compress to half blocks if the art is wider than the screen
        rows = [_shrink_half(r) for r in rows]
        aw = len(rows[0])
    if aw > W:
        rows = [r[:W] for r in rows]   # still too wide: truncate (prevents wrapping)
        aw = W
    lead = ' ' * ((W - aw) // 2) if aw < W else ''

    palette = palette or RAINBOW
    # Blue->white gradient: apply the left->right ramp independently per line.
    # The old rainbow cycled line colors, but now every line uses the same blue->white theme.
    # The source art has no SGR, so prepend bold (ESC[1m) to preserve weight.
    colored = [gradientize("\x1b[1m" + r) for r in rows]

    step = 1.0 / max(1.0, float(fps or RAIN_DROP_FPS))

    # Drop: the logo starts above the screen (-n_rows) and descends once to its landing position.
    # The landing position is vertically centered when there is room, otherwise the very top.
    y_end = max(0, (H - n_rows) // 2)
    y_start = -n_rows
    dist = max(1, y_end - y_start)

    hide = "\x1b[?25l"
    show = "\x1b[?25h"
    erase = "\x1b[K"
    dur = max(0.0, float(drop_sec))
    t0 = time.time()

    def draw(y):
        """Redraw the whole screen to match the current logo position y."""
        out = ["\x1b[H"]
        for yy in range(H):
            ri = yy - y
            if 0 <= ri < n_rows:
                out.append(lead + colored[ri] + erase)
            else:
                out.append(erase)
        sys.stdout.write("\n".join(out))
        sys.stdout.flush()

    sys.stdout.write(hide)
    try:
        while True:
            el = time.time() - t0
            if dur <= 0 or el >= dur:
                y = y_end
            else:
                p = el / dur
                p = 1.0 - (1.0 - p) ** 3   # deceleration: fast at first, lands smoothly at the end
                y = y_start + int(round(dist * p))
            draw(y)
            if dur > 0 and el < dur:
                time.sleep(step)
            else:
                break
        # hold still: do not redraw, just wait hold_sec seconds
        if hold_sec > 0:
            time.sleep(hold_sec)
    except KeyboardInterrupt:
        pass                     # allow skipping the intro with Ctrl+C
    finally:
        sys.stdout.write("\x1b[2J\x1b[H" + show)
        sys.stdout.flush()


# ---------------------------------------------------------------------------
# (old) digital character cascade -- fallback for art_rain on consoles without block chars
# ---------------------------------------------------------------------------
def matrix_rain(seconds=2.0, fps=32, cols=0, rows=0,
                head_prob=0.005, near_prob=0.03, dim_prob=0.16,
                head_code="\x1b[97;1m", near_code="\x1b[92m",
                dim_code="\x1b[32m"):
    """
    Digital cascade (rain) effect where characters pour across the whole terminal.

    Each vertical column flows down at its own speed,
    the head character is bright and trailing characters fade progressively darker.
    Does nothing if color is off or this is not a real terminal (console).
    """
    if not (_COLOR and sys.stdout and sys.stdout.isatty()):
        return
    if seconds <= 0:
        return

    import random as _rnd

    if cols > 0 and rows > 0:
        W, H = cols, rows
    else:
        W, H = _term_wh()
        H = max(6, H - 1)          # reserve the bottom line

    hp, np_, dp = head_prob, near_prob, dim_prob
    n_chars = len(RAIN_CHARS)
    rnd = _rnd.random

    # per-column 'fallen position' and speed (speed changes often for a natural flow)
    off = [rnd() * 5000.0 for _ in range(W)]
    spd = [_rnd.uniform(0.5, 1.35) for _ in range(W)]

    rst = C.RST
    hide = "\x1b[?25l"
    show = "\x1b[?25h"
    step = 1.0 / max(1, fps)
    next_tick = time.time()
    deadline = next_tick + seconds

    sys.stdout.write(hide)
    try:
        while True:
            now = time.time()
            if now >= deadline:
                break

            for c in range(W):
                off[c] += spd[c]
                if rnd() < 0.03:
                    spd[c] = _rnd.uniform(0.5, 1.35)

            frame = ["\x1b[H"]
            for r in range(H):
                row = []
                for c in range(W):
                    k = int(off[c]) - r        # position on the character tape (flows downward)
                    # column/position-based deterministic noise -> stable moss (tail) without flicker
                    v = c * 2246822519 + k * 3266489917
                    v ^= v >> 15
                    v &= 0x7fffffff
                    frac = (v % 100000) * 1e-5
                    if frac < hp:
                        ch = RAIN_CHARS[(k + c * 5) % n_chars]
                        row.append(head_code + ch + rst)
                    elif frac < hp + np_:
                        ch = RAIN_CHARS[(k * 3 + c * 7) % n_chars]
                        row.append(near_code + ch + rst)
                    elif frac < hp + np_ + dp:
                        ch = RAIN_CHARS[(k * 7 + c * 11) % n_chars]
                        row.append(dim_code + ch + rst)
                    else:
                        row.append(" ")
                frame.append("".join(row))
            # move the cursor to the top and overwrite a whole screen
            sys.stdout.write("\n".join(frame) + "\x1b[0J")
            sys.stdout.flush()

            next_tick += step
            delay = next_tick - time.time()
            if delay > 0:
                time.sleep(delay)
    except KeyboardInterrupt:
        pass                     # allow skipping the intro with Ctrl+C
    finally:
        sys.stdout.write("\x1b[2J\x1b[H" + show)
        sys.stdout.flush()


# ---------------------------------------------------------------------------
# Main screen
# ---------------------------------------------------------------------------
_BOOT_LINES = [
    ("ESTABLISHING C2 UPLINK", "ONLINE"),
    ("DECRYPTING PACKET PAYLOAD GRID", "UNLOCKED"),
    ("MOUNTING LAYER-7 / LAYER-4 LAUNCHERS", "56+ UNITS"),
    ("HANDSHAKE WITH ANONYMOUS GATEWAYS", "STANDBY"),
]


_BOOT_SHOWN = False     # boot log (stream) is printed only once


# ---------------------------------------------------------------------------
# Brain-style rendering helpers (news1 / news2 style)
# ---------------------------------------------------------------------------
_BOX_V = "|"
_BOX_H = "-"
_BOX_TL = "/"
_BOX_TR = "\\"
_BOX_BL = "\\"
_BOX_BR = "/"

# Red family from the ANSI 256-color palette (dark -> bright gradient look)
def _red_grad(i, n):
    """Return a dark red -> bright red 256-color code for i (0..n-1)."""
    if n <= 1:
        return "\x1b[38;5;160m"
    steps = [88, 124, 160, 196, 202, 208, 214, 220]   # dark -> bright (red->orange)
    t = i / (n - 1)
    idx = t * (len(steps) - 1)
    lo = int(idx)
    hi = min(lo + 1, len(steps) - 1)
    frac = idx - lo
    base = steps[lo]
    nxt = steps[hi]
    # 256-color codes cannot be interpolated, so snap to the nearest
    pick = steps[lo] if frac < 0.5 else steps[hi]
    return f"\x1b[38;5;{pick}m"


def brain_logo(art=BRAIN_ART):
    """Print the 'BRAIN' logo with a left (dark) -> right (bright) red gradient."""
    lines = art.rstrip("\n").split("\n")
    W = max((len(l) for l in lines), default=0)
    out = []
    for ln in lines:
        row = []
        for c, ch in enumerate(ln):
            if ch == " ":
                row.append(" ")
            else:
                code = _red_grad(c, W)
                if _COLOR:
                    row.append(f"{code}{ch}{C.RST}")
                else:
                    row.append(ch)
        out.append("".join(row))
    return out


def _plain(s):
    """Compute display width after removing ANSI codes (full-width chars count as 2)."""
    import re as _re
    import unicodedata as _ud
    txt = _re.sub(r"\x1b\[[0-9;]*m", "", s)
    w = 0
    for ch in txt:
        if _ud.east_asian_width(ch) in ("W", "F"):
            w += 2
        else:
            w += 1
    return w


# ---------------------------------------------------------------------------
# Double-line box panel (╔═══╗ / ║ ║ / ╚═══╝) -- shared by main and all menus
# ---------------------------------------------------------------------------
_DBX_TL, _DBX_TR = "╔", "╗"
_DBX_BL, _DBX_BR = "╚", "╝"
_DBX_V, _DBX_H = "║", "═"


def dbl_panel(inner_lines, indent=2, title=None, width=0, center=True):
    """Double-line (╔═╗) box panel. inner_lines is a list of already-painted strings.

    If title is given it is engraved into the top border as '╔═ TITLE ═══╗'.
    If width is given it guarantees a minimum inner width.
    Returns the completed list of line strings (the caller streams them with typewrite).
    """
    if isinstance(inner_lines, str):
        inner_lines = [inner_lines]
    inner_lines = list(inner_lines) if inner_lines else [""]
    title_w = _plain(title) if title else 0
    content_w = max([_plain(l) for l in inner_lines] + [title_w] + [14])
    inner_w = max(content_w + 2, int(width) if width else 0, 20)
    if center:
        indent = max(0, (term_width() - (inner_w + 2)) // 2)
    pad = " " * indent

    if title:
        seg = "═ " + title + " "
        seg_w = _plain(seg)
        top = pad + _DBX_TL + seg + _DBX_H * max(2, inner_w - seg_w) + _DBX_TR
    else:
        top = pad + _DBX_TL + _DBX_H * inner_w + _DBX_TR

    rows = [top]
    for ln in inner_lines:
        fill = inner_w - _plain(ln) - 1
        rows.append(pad + _DBX_V + " " + ln + " " * max(0, fill) + _DBX_V)
    rows.append(pad + _DBX_BL + _DBX_H * inner_w + _DBX_BR)
    return rows


def draw_dbl_panel(inner_lines, indent=2, title=None, width=0, delay=0.04,
                   center=True):
    """Print the dbl_panel result directly as a top->down vertical flow."""
    for ln in dbl_panel(inner_lines, indent=indent, title=title, width=width,
                        center=center):
        typewrite(ln, delay=delay)


def box_panel(inner_lines, indent=2, title=None):
    """(old) news1-style rounded box panel -- backward compatibility only. New code uses dbl_panel."""
    if isinstance(inner_lines, str):
        inner_lines = [inner_lines]
    content_w = max([_plain(l) for l in inner_lines] + ([_plain(title) + 4] if title else [0]))
    width = content_w + 2                 # 1 column of padding on each side
    width = max(width, 22)
    pad = " " * indent

    if title:
        # top border: /---- title ----\
        seg = pad + _BOX_TL + _BOX_H * 2 + " " + title + " "
        top = seg + _BOX_H * max(1, width - (_plain(seg) - indent - len(pad) + 2)) + _BOX_TR
    else:
        top = pad + _BOX_TL + _BOX_H * max(2, width - 2) + _BOX_TR

    body = []
    if title:
        body.append(top)
    else:
        body.append(top)
    for ln in inner_lines:
        pad_len = width - _plain(ln)
        body.append(pad + _BOX_V + " " + ln + " " * max(0, pad_len - 2) + _BOX_V)
    bottom = pad + _BOX_BL + _BOX_H * max(2, width - 2) + _BOX_BR
    body.append(bottom)
    return body


def dotted_panel(title_lines, rows, indent=2, title_color=C.CY):
    """news2 style: a title row + dotted leader rows.

    title_lines : banner strings (Attack Details |  /  Target Details |)
    rows        : list of (label, value_label, value)  -- value_label=(color)
    """
    if isinstance(title_lines, str):
        title_lines = [title_lines]
    max_lab = max([_plain(l) for l in title_lines] + [len(r[0]) for r in rows], default=10)
    total_w = max_lab + 26
    pad = " " * indent

    out = []
    # title row
    for tl in title_lines:
        out.append(pad + paint(tl, title_color, bold=True))
    out.append("")

    for label, vcolor, value in rows:
        lead = max_lab - len(label) + 2
        leader = "." * max(6, lead)
        line = ("· " + paint(label, C.W) + " " +
                paint(leader, C.DIM) + "  " +
                paint(f"[ {value} ]", vcolor, bold=True))
        out.append(pad + line)
    return out


def show_main_screen(intro=None):
    """Main art banner + title.

    intro=None : automatic ('drop then hold 1s' on first entry, a short drop on return)
    intro=number : set the total effect (drop + hold) time to that many seconds
    intro=0    : banner only, no effect
    """
    global _RAIN_PLAYED, _BOOT_SHOWN

    if intro is None:
        if not _RAIN_PLAYED:
            drop_sec, hold_sec = RAIN_DROP_SEC, RAIN_HOLD_SEC
            _RAIN_PLAYED = True
        else:
            drop_sec, hold_sec = RAIN_REPEAT_DROP_SEC, RAIN_REPEAT_HOLD_SEC
    elif not intro:
        drop_sec = hold_sec = 0.0
    else:
        # numeric value: interpreted as the total effect (drop + hold) time
        total = max(0.0, float(intro))
        drop_sec = min(RAIN_DROP_SEC, max(0.2, total * 0.4))
        hold_sec = max(0.0, total - drop_sec)

    # 1) the logo pours down once from the top, stops, then switches to main
    if drop_sec > 0:
        art_drop(drop_sec, hold_sec)

    # 2) render the RAIN art + 3 double-line boxes (top->down vertical flow)
    clear_screen()
    print("")

    # top: the RAIN box letter art flows from top to bottom
    for ln in banner_rainbow(MAIN_ART):
        typewrite(ln, delay=0.04)
    time.sleep(0.08)

    # box 1 (large box): welcome message + version info
    draw_dbl_panel([
        paint("WELCOME TO RAIN C2", C.W, bold=True),
        "",
        paint(f"{_VERSION}   |   {_METHOD_COUNT} ATTACK METHODS   |   AUTHORIZED SECURITY TESTING ONLY", C.CY),
    ], indent=2, title="RAIN ENGINE", width=64)
    print("")

    # 3) boot stream line only on first entry (C2 panel feel)
    if not _BOOT_SHOWN:
        _BOOT_SHOWN = True
        label_w = 44
        for label, status in _BOOT_LINES:
            # assemble the whole line first, then stream it with a single typewrite.
            # (typewrite applies the light-blue->sky-blue gradient line by line, continuously)
            row = (paint("  " + label, C.W)
                   + paint("." * max(0, label_w - len(label)) + " ", C.DIM)
                   + paint(status, C.G, bold=True))
            typewrite(row, delay=0.04)
            time.sleep(0.06)
        typewrite(paint("  ALL SYSTEMS READY  --  STAND BY FOR ORDERS", C.DIM),
                  delay=0.04)
        time.sleep(0.1)
        print("")

    # box 2 (small box, indented inward): author credit
    draw_dbl_panel([
        paint("MADE BY SEOJUN", C.W, bold=True),
    ], title="AUTHOR", width=44)
    print("")

    # box 3 (large box): menu items
    menu_lines = [
        paint("TYPE /HELP TO WATCH THE COMMANDS", C.Y, bold=True),
    ]
    draw_dbl_panel(menu_lines, title="RAIN  MAIN SCREEN", width=64)
    print("")


def open_screen(art, header, sub=None):
    """Option entry screen: clears the screen and presents dedicated art + a double-line box header."""
    clear_screen()
    print("")
    for ln in banner_rainbow(art):
        typewrite(ln, delay=0.04)
    time.sleep(0.08)
    print("")
    head_lines = [paint(header, C.W, bold=True)]
    if sub:
        head_lines.append(paint(sub, C.CY))
    draw_dbl_panel(head_lines, indent=2, title=header.split()[0] if header else None,
                   width=64)
    print("")

