}


def _layer_label(method):
    return _LAYER7_LABEL.get(method.upper(), method)


def show_attack_start(method, target, address, port, threads, duration,
                      is_layer7=True, proxy_count=0):
    """
    Streams a 'weapon loading + target info' effect paragraph by paragraph right before the attack launches.
    """
    layer = "LAYER-7 / HTTP FLOOD" if is_layer7 else "LAYER-4 / NETWORK FLOOD"
    method_disp = method.upper()

    # paragraph 1: clear the screen and present the large ATTACK art
    clear_screen()
    print("")
    for ln in banner_rainbow(ATTACK_ART, color_cycle=[C.R, C.Y, C.R, C.W]):
        typewrite(ln, delay=0.04)
    time.sleep(0.1)

    # paragraph 2: stream the target / settings summary in a double-line box
    draw_dbl_panel([
        paint(f"HOST     : {target}", C.W),
        paint(f"ADDRESS  : {address}", C.W),
        paint(f"PORT     : {port or 80}", C.W),
    ], indent=2, title="TARGET-SYSTEM")
    print("")
    draw_dbl_panel([
        paint(f"METHOD   : {method_disp:<10} ({layer})", C.Y),
        paint(f"THREADS  : {threads:,}", C.Y),
        paint(f"DURATION : {duration} SEC", C.Y),
        paint(f"PROXY    : {proxy_count:,} ACTIVE" if proxy_count else
              f"PROXY    : NONE (DIRECT)", C.Y),
    ], indent=2, title="ATTACK-PROFILE")
    print("")

    # paragraph 3: loading/launch effect
    steps = [
        "[>] ARMING PACKET ENGINE ............ " + paint("OK", C.G, bold=True),
        "[>] LOADING PAYLOAD MAGAZINES ....... " + paint("OK", C.G, bold=True),
        "[>] WARMING UP CONNECTION POOL ...... " + paint("OK", C.G, bold=True),
        f"[>] SPINNING UP THREAD ARMY ........ {threads:,} UNITS " + paint("DEPLOYED", C.G, bold=True),
        "[>] SYNCHRONIZING FIRE CONTROL ...... " + paint("LOCKED", C.G, bold=True),
    ]
    for st in steps:
        typewrite(paint("  ", C.R) + st, delay=0.04)
    time.sleep(0.1)

    print(paint("  ********  ALL ENGINES ENGAGED  --  UNLEASH THE STORM  ********", C.R, bold=True))
    print("", flush=True)
    time.sleep(0.2)


# ---------------------------------------------------------------------------
# Real-time status bar
# ---------------------------------------------------------------------------
_SPIN = ("-", "\\", "|", "/")


def _human_unit(num, suffix):
    for unit in ("", "K", "M", "G", "T", "P"):
        if num < 1000:
            return f"{num:.1f} {unit}{suffix}"
        num /= 1000.0
    return f"{num:.1f} E{suffix}"


def human_bps(num):
    """Simplify the BPS display."""
    return _human_unit(num, "B/s").replace(" B/s", " B/s")


def human_size(num):
    """Byte total display."""
    return _human_unit(num, "B").replace("B/s", "B") if False else \
        _human_unit(num, "B").replace(" B", " B")


def human_bytes(num):
    """Transferred total display (B/KB/MB/GB)."""
    return _human_unit(num, "B").replace("KB", "KB")


def human_pps(num):
    """Simplify the PPS display."""
    for unit in ("", "k", "M", "G"):
        if num < 1000:
            return f"{num:.1f}{unit}"
        num /= 1000.0
    return f"{num:.1f}T"


def _wide_ok():
    """Check whether the █ ░ block characters can be used with the current stdout encoding."""
    try:
        enc = getattr(sys.stdout, "encoding", None) or "utf-8"
        "\u2588\u2591".encode(enc)
        return True
    except Exception:
        return False


def render_status(step, total_steps, method, target, pps, bps, threads,
                  elapsed, duration):
    """Single-line progress bar refreshed every second."""
    pct = min(100.0, max(0.0, elapsed / max(duration, 1) * 100.0))
    bar_w = 18
    filled = int(round(pct / 100.0 * bar_w))
    if _wide_ok():
        bar = "\u2588" * filled + "\u2591" * (bar_w - filled)   # █ ░
    else:
        bar = "#" * filled + "-" * (bar_w - filled)             # ASCII fallback

    spin = _SPIN[step % len(_SPIN)]
    info = (f"{paint('[' + spin + ']', C.M)}"
            f"{paint(' ' + method.upper(), C.CY, bold=True)}"
            f"{paint(' ' + target[:40], C.W)}"
            f"{paint('  [' + bar + ']', C.G)}"
            f"{paint(f' {pct:5.1f}%', C.Y)}"
            f"{paint(f' PPS {human_pps(pps):>8}', C.CY)}"
            f"{paint(f' BPS {human_bps(bps):>10}', C.M)}"
            f"{paint(f' {elapsed:>4}s/{duration}s', C.W)}"
            f"{paint(f' T:{threads}', C.DIM)}")

    width = min(term_width() - 1, 100)
    pad = max(0, width - _plain_len(info))
    try:
        print("\r" + info + " " * pad, end="", flush=True)
    except UnicodeEncodeError:
        plain = (f"\r[{spin}] {method.upper()} {target[:30]} "
                 f"[{bar}] {pct:5.1f}% PPS {pps} BPS {bps} "
                 f"{elapsed}s/{duration}s T:{threads}")
        print(plain + " " * max(0, width - len(plain)), end="", flush=True)


def _plain_len(styled):
    """Compute the pure length after removing ANSI codes."""
    import re as _re
    return len(_re.sub(r"\x1b\[[0-9;]*m", "", styled))


# ---------------------------------------------------------------------------
# Attack finish effect
# ---------------------------------------------------------------------------
def show_attack_end(total_requests, total_bytes):
    """After finishing, clear the screen and present the large FINISH art + stats summary."""
    clear_screen()
    print("")
    for ln in banner_rainbow(FINISH_ART, color_cycle=[C.G, C.CY, C.G, C.W]):
        typewrite(ln, delay=0.04)
    time.sleep(0.1)
    print(paint("  ********  ALL ENGINES HALTED  --  ATTACK MISSION COMPLETE  ********", C.G, bold=True))
    print("")

    draw_dbl_panel([
        paint("FIRE CONTROL         : ALL ENGINES HALTED", C.G),
        paint(f"TOTAL PACKETS SENT   : {total_requests:,}", C.G),
        paint(f"TOTAL BYTES DEPLOYED : {human_bytes(total_bytes) if total_bytes else '0 B'}", C.G),
        paint("MISSION STATUS       : COMPLETE", C.G),
    ], indent=2, title="MISSION SUMMARY")
    print("", flush=True)


# ---------------------------------------------------------------------------
# Interactive main menu
# ---------------------------------------------------------------------------
def _ask(prompt_text, default=None):
    """If a default exists, Enter keeps it."""
    if default is not None:
        prompt_text = f"{prompt_text} [{default}] "
    try:
        val = input(prompt_text).strip()
    except (EOFError, KeyboardInterrupt):
        print("")
        raise SystemExit(0)
    return val if val else (default if default is not None else "")


def _ask_int(prompt_text, default, minimum=1, maximum=None):
    """Integer input validation prompt. Asks again on an invalid value.
    Returns None on MENU / BACK / Q / EXIT so the caller can treat it as a cancel."""
    if default is not None:
        prompt_text = f"{prompt_text} [{default}] "
    while True:
        try:
            raw = input(prompt_text).strip()
        except (EOFError, KeyboardInterrupt):
            print("")
            raise SystemExit(0)
        if not raw:
            raw = default
        up = raw.upper()
        if up in {"MENU", "BACK", "Q", "EXIT", "CANCEL", "X"}:
            return None
        try:
            val = int(up)
        except ValueError:
            print(paint(f"[!] Enter digits only. (e.g. {default})", C.R))
            continue
        if val < minimum:
            print(paint(f"[!] Must be at least {minimum}.", C.R))
            continue
        if maximum is not None and val > maximum:
            print(paint(f"[!] Must be at most {maximum}.", C.R))
            continue
        return val


def _ask_required(prompt_text, err_msg):
    """If the value is empty, print err_msg and ask the same question again.
    Returns None on MENU / BACK / Q / EXIT so the caller can treat it as a cancel."""
    while True:
        try:
            val = input(prompt_text).strip()
        except (EOFError, KeyboardInterrupt):
            print("")
            raise SystemExit(0)
        if not val:
            print(paint(f"[!] {err_msg}", C.R))
            continue
        if val.upper() in {"MENU", "BACK", "Q", "EXIT", "CANCEL", "X"}:
            return None
        return val


def _run_attack(script, argv_args):
    """Run start.py as a subprocess (without showing the main screen again)."""
    print("")
    typewrite(paint("[i] EXECUTING ATTACK MODULE .........", C.CY), delay=0.04)
    typewrite(paint("OK", C.G, bold=True), delay=0.04)
    print("", flush=True)
    try:
        subprocess.run([sys.executable, script] + argv_args, check=False)
    except KeyboardInterrupt:
        print("")
        typewrite(paint("[!] ATTACK INTERRUPTED BY OPERATOR", C.Y), delay=0.04)
    except Exception as exc:
        print(paint(f"[!] LAUNCH FAILED : {exc}", C.R, bold=True))


# ---------------------------------------------------------------------------
# METHODS color grid (shared by wizard / EXPERT / full list)
# ---------------------------------------------------------------------------
_METHOD_PALETTE = [C.CY, C.G, C.Y, C.M, C.B, C.R, C.W]


def _method_color(idx):
    """Return a different character color per index in the METHODS grid."""
    return _METHOD_PALETTE[idx % len(_METHOD_PALETTE)]


def show_method_panel(title, methods, numbered=False, indent="  "):
    """Print the whole METHODS list as a column grid with character colors.

    With numbered=True it prefixes 1..N numbers (for wizard selection).
    The color alone, even without the name, distinguishes which method is which.
    """
    mlist = sorted({str(m).upper() for m in methods})
    if not mlist:
        return
    # normalize indent so it accepts either a string ("  ") or an int (2)
    n_ind = indent if isinstance(indent, int) else len(indent)
    digits = len(str(len(mlist)))
    name_w = max(len(m) for m in mlist)
    cell_w = (digits + 2 if numbered else 0) + name_w + 2
    avail = max(40, term_width() - n_ind)
    cols = max(1, min(6, avail // max(cell_w, 12)))
    rows = [mlist[i:i + cols] for i in range(0, len(mlist), cols)]
    grid = []
    for r_i, row in enumerate(rows):
        cells = []
        for c_j, m in enumerate(row):
            gi = r_i * cols + c_j
            name = paint(m.ljust(name_w), _method_color(gi), bold=True)
            if numbered:
                cells.append(paint(f"{gi + 1:>{digits}}: ", C.DIM) + name)
            else:
                cells.append(name)
        grid.append(("   ".join(cells)).rstrip())
    draw_dbl_panel(grid, indent=n_ind,
                   title=f"{title}  ({len(mlist)} METHODS)")
    print("")


_CANCEL_WORDS = {"MENU", "BACK", "Q", "EXIT", "CANCEL", "X", "QUIT"}


def _pick_method(layer_title, methods, default_method):
    """On the layer wizard's first screen, show the whole METHODS list with colors/numbers and pick one.

    Selectable by method name (GET, POST ...) or list number (1, 2, 3 ...).
    Returns None on cancel input such as MENU / BACK / Q.
    """
    methods = sorted(methods)
    show_method_panel(layer_title + "  --  ALL METHODS", methods, numbered=True)
    while True:
        raw = (_ask("SELECT METHOD (name or number)", default_method)
               .strip().upper() or default_method)
        if raw in _CANCEL_WORDS:
            return None
        if raw.isdigit():
            idx = int(raw)
            if 1 <= idx <= len(methods):
                return methods[idx - 1]
            print(paint(f"[!] Enter a number between 1 and {len(methods)}.", C.R))
            continue
        if raw in methods:
            return raw
        print(paint(f"[!] Unknown method: {raw}  (enter a name or number from the list above)", C.R))


def wizard_layer7(script, methods):
    open_screen(LAYER7_ART, "LAYER-7  WEB FLOOD  (web attack wizard)",
                "GET / POST / OVH / CFB / DYN / SLOW / RHEX ... attack setup")
    methods = sorted(methods)
    default_method = "GET" if "GET" in methods else methods[0]
    # show all METHODS with colors/numbers from the start and select by name or number
    method = _pick_method("LAYER-7 (WEB)", methods, default_method)
    if method is None:
        return

    url = _ask_required("TARGET URL  (e.g. https://example.com)", "A target URL is required.")
    if url is None:
        return
    if not url.lower().startswith("http"):
        url = "http://" + url

    while True:
        socks = _ask("SOCKS TYPE  0=ALL 1=HTTP 4=SOCKS4 5=SOCKS5 (default 1)", "1").strip()
        if not socks:
            socks = "1"
        if socks.upper() in {"MENU", "BACK", "Q", "EXIT", "CANCEL", "X"}:
            return
        if socks in {"0", "1", "4", "5", "6"}:
            break
        print(paint("[!] Enter only one of 0, 1, 4, 5, 6 for SOCKS TYPE.", C.R))

    threads = _ask_int("THREADS  (thread count, default 300)", "300", minimum=1)
    if threads is None:
        return
    rpc = _ask_int("RPC  (requests per connection, default 1)", "1", minimum=1)
    if rpc is None:
        return
    proxylist = _ask("PROXY LIST  (file name, default http.txt)", "http.txt").strip()
    if not proxylist:
        proxylist = "http.txt"
    if proxylist.upper() in {"MENU", "BACK", "Q", "EXIT", "CANCEL", "X"}:
        return
    if "/" not in proxylist and not proxylist.lower().endswith(".txt"):
        proxylist += ".txt"
    duration = _ask_int("DURATION  (attack seconds, default 60)", "60", minimum=1)
    if duration is None:
        return

    print("")
    draw_dbl_panel([
        paint(f"METHOD    : {method}", C.W),
        paint(f"TARGET    : {url}", C.W),
        paint(f"SOCKS     : {socks}    THREADS : {threads}", C.W),
        paint(f"RPC       : {rpc}    PROXY   : {proxylist}", C.W),
        paint(f"DURATION  : {duration} sec", C.W),
    ], indent=2, title="CONFIRM ATTACK SETTINGS")
    print("")
    go = _ask("Press ENTER to start the attack, type C to cancel", "").upper()
    if go in {"C", "CANCEL", "X", "NO"}:
        return
    _run_attack(script, [method, url, socks, str(threads), proxylist, str(rpc), str(duration)])


def wizard_layer4(script, methods):
    open_screen(LAYER4_ART, "LAYER-4  NETWORK FLOOD  (server attack wizard)",
                "TCP / UDP / SYN / ICMP / NTP / DNS / MEM / RDP attack setup")
    methods = sorted(methods)
    default_method = "TCP" if "TCP" in methods else methods[0]
    # show all METHODS with colors/numbers from the start and select by name or number
    method = _pick_method("LAYER-4 (NETWORK)", methods, default_method)
    if method is None:
        return

    target = _ask_required("TARGET IP:PORT  (e.g. 1.2.3.4:80)", "A target IP:PORT is required.")
    if target is None:
        return
    if ":" not in target:
        target += ":80"
    threads = _ask_int("THREADS  (default 500)", "500", minimum=1)
    if threads is None:
        return
    duration = _ask_int("DURATION  (sec, default 60)", "60", minimum=1)
    if duration is None:
        return

    print("")
    draw_dbl_panel([
        paint(f"METHOD    : {method}", C.W),
        paint(f"TARGET    : {target}", C.W),
        paint(f"THREADS   : {threads}", C.W),
        paint(f"DURATION  : {duration} sec", C.W),
    ], indent=2, title="CONFIRM ATTACK SETTINGS")
    print("")
    go = _ask("Press ENTER to start the attack, type C to cancel", "").upper()
    if go in {"C", "CANCEL", "X", "NO"}:
        return
    _run_attack(script, [method, target, str(threads), str(duration)])


def expert_cmd(script, l7, l4):
    open_screen(EXPERT_ART, "EXPERT  (direct command execution)",
                "Advanced console to enter L7 / L4 arguments directly on one line")
    # show the available METHODS first as a color grid
    show_method_panel("LAYER-7 (WEB) METHODS", sorted(l7))
    show_method_panel("LAYER-4 (NETWORK) METHODS", sorted(l4))
    print("")
    draw_dbl_panel([
        paint("L7", C.CY, bold=True) + " :  " + paint("METHOD", C.Y, bold=True) +
        " URL SOCKS THREADS PROXYLIST RPC DURATION",
        "     e.g. " + paint("GET", C.G, bold=True) +
        " https://example.com 1 300 http.txt 1 60",
        "",
        paint("L4", C.CY, bold=True) + " :  " + paint("METHOD", C.Y, bold=True) +
        " IP:PORT THREADS DURATION",
        "     e.g. " + paint("UDP", C.G, bold=True) + " 1.2.3.4:53 200 60",
        "",
        "Type BACK / MENU to return",
    ], indent=2, title="COMMAND FORMAT")
    print("")
    line = _ask("\U0001d4e1\U0001d4b6\U0001d4be\U0001d4c3# ")
    if not line or line.upper() in {"BACK", "MENU", "EXIT", "Q"}:
        return
    parts = line.split()
    if not parts:
        return
    method = parts[0].upper()
    if method in l7:
        need = 7
    elif method in l4:
        need = 3
    else:
        print(paint(f"[!] Unknown method: {method}", C.R))
        return
    if len(parts) < need:
        print(paint(f"[!] Not enough arguments. (needed: {need}, given: {len(parts)})", C.R))
        return
    if method in l7 and not parts[1].lower().startswith("http"):
        parts[1] = "http://" + parts[1]
    if method in l4 and ":" not in parts[1]:
        parts[1] += ":80"
    # validate numeric arguments up front since passing bad ones makes the child process error
    try:
        if method in l7:
            socks_t = parts[2]
            if socks_t not in {"0", "1", "4", "5", "6"}:
                raise ValueError("SOCKS TYPE must be one of 0,1,4,5,6")
            int(parts[3])                  # threads
            int(parts[5])                  # rpc
            if int(parts[6]) < 1:          # duration
                raise ValueError("DURATION must be at least 1")
        else:
            int(parts[2])                  # threads
            if int(parts[3]) < 1:          # duration
                raise ValueError("DURATION must be at least 1")
    except (ValueError, IndexError) as exc:
        print(paint(f"[!] Argument error : {exc}  (recheck the numeric positions)", C.R))
        return
    _run_attack(script, parts)


def show_all_methods(l7, l4):
    open_screen(METHODS_ART, "ALL ATTACK METHODS",
                "LAYER-7 (WEB) + LAYER-4 (NETWORK) full list")
    show_method_panel("LAYER-7 (WEB) METHODS", sorted(l7))
    show_method_panel("LAYER-4 (NETWORK) METHODS", sorted(l4))
    pour([
        ["  TOOLS methods : INFO  DNS  PING  CHECK  DSTAT  TSSRV  CFIP",
         "  special cmds  : TOOLS(console)  HELP  STOP"],
    ], para_gap=0.05, char_delay=0.04)


def show_help():
    """Show the available commands in a double-line box when /help is entered on the main menu."""
    print("")
    draw_dbl_panel([
        paint("[1]   LAYER-7     START WEB ATTACK", C.W),
        paint("[2]   LAYER-4     START NETWORK ATTACK", C.W),
        paint("[3]   TOOLS       ENTER TOOLS CONSOLE", C.W),
        paint("[4]   EXPERT      DIRECT COMMAND EXECUTION", C.W),
        paint("[0]   EXIT        QUIT", C.W),
        "",
        paint("TOOLS console cmds : INFO  TSSRV  CFIP  DNS  PING  CHECK  DSTAT", C.CY),
        paint("TOOLS special cmds : HELP  CLEAR  BACK  EXIT", C.CY),
        "",
        paint("/help           show this command help again", C.Y, bold=True),
    ], title="RAIN C2 COMMANDS", width=64)
    print("")


def interactive_main(l7_methods, l4_methods, script):
    """Main screen loop when start.py is run without arguments."""
    init()
    if not l7_methods:
        l7_methods = ["GET", "POST", "OVH", "CFB", "DYN", "SLOW", "RHEX", "STOMP",
                      "STRESS", "BYPASS", "PPS", "BOMB", "DOWNLOADER"]
    if not l4_methods:
        l4_methods = ["TCP", "UDP", "SYN", "ICMP", "NTP", "DNS", "MEM", "RDP"]

    l7 = set(l7_methods)
    l4 = set(l4_methods)

    while True:
        # show_main_screen draws everything (RAIN art + 3 boxes + menu box)
        show_main_screen()

        try:
            choice = input(paint("  \U0001d4e1\U0001d4b6\U0001d4be\U0001d4c3> ", C.M, bold=True)).strip().lower()
        except (EOFError, KeyboardInterrupt):
            print("")
            break

        if choice in {"0", "exit", "quit", "q", "e", "x"}:
            typewrite(paint("[!] SHUTTING DOWN ...", C.Y), delay=0.04)
            break

        try:
            if choice == "1":
                wizard_layer7(script, sorted(l7))
            elif choice == "2":
                wizard_layer4(script, sorted(l4))
            elif choice == "3":
                open_screen(TOOLS_ART, "TOOLS  tools console",
                            "INFO / DNS / PING / CHECK / DSTAT / TSSRV / CFIP")
                _run_attack(script, ["TOOLS"])
            elif choice == "4":
                expert_cmd(script, l7, l4)
            elif choice in {"help", "h", "?", "/help", "/h", "/?",
                            "/commands", "/cmd"}:
                show_help()
            else:
                print(paint(f"  [!] Unknown command : {choice}   (enter 0-4)", C.R))
        except Exception as exc:
            print(paint(f"  [!] Unexpected error : {exc}", C.R, bold=True))

        typewrite(paint("\n  [i] Press ENTER to return to the main screen ...", C.DIM), delay=0.04)
        try:
            input("")
        except (EOFError, KeyboardInterrupt):
            print("")
            break


